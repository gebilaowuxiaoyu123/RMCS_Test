    EXT2["上游 · 相机 / 裁判 / 遥控 / 导航 / IMU"]
    RC2["遥控"]
    REF2["裁判"]

    EXT2 --> AC2
    AC2 == "方法调用 update() · 喂状态" ==> FC2
    FC2 == "方法返回 aim() · 输出 Aimed" ==> AC2
